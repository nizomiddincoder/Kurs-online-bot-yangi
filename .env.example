# Bu faylni nusxalab ".env" deb nomlang va qiymatlarni to'ldiring (faqat lokal test uchun).
# Railway'da bu qiymatlar "Variables" bo'limiga kiritiladi.

# @BotFather bergan token
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Adminlarning Telegram ID lari, vergul bilan (@userinfobot orqali bilib olasiz)
ADMIN_IDS=123456789,987654321

# Bo'sh qoldirilsa lokal SQLite (bot.db) ishlatiladi.
# Railway'da: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Bepul kanal: ID (-100...) yoki @username, va havolasi
FREE_CHANNEL_ID=-1001111111111
FREE_CHANNEL_LINK=https://t.me/bepul_kanal

# Pullik kanal ID si (faqat raqam, -100 bilan boshlanadi)
PAID_CHANNEL_ID=-1002222222222

# To'lov kartasi
CARD_NUMBER=8600 1234 5678 9012
CARD_HOLDER=Azamatjon Nabiyev

# Narxlar (so'm)
PAID_CHANNEL_PRICE=25000
TARIFF_BASIC=250000
TARIFF_MIDDLE=500000
TARIFF_SENIOR=750000

# Senior tarifidagi joylar soni (ixtiyoriy, standart 20)
SENIOR_LIMIT=20

TIMEZONE=Asia/Tashkent

# Web admin-panel paroli (kamida 12 belgi, harf+raqam). Bo'sh bo'lsa panel o'chiq.
ADMIN_PANEL_PASSWORD=
# Lokal testda panel http://localhost:8080 da ochiladi. Railway PORT ni o'zi beradi.
PORT=8080
