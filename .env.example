# Bu faylni nusxalab ".env" deb nomlang va qiymatlarni to'ldiring (faqat lokal test uchun).
# Railway'da bu qiymatlar "Variables" bo'limiga kiritiladi.
# Kanal ID lari, narxlar, dars vaqti va kod so'zni web-panel → Sozlamalar'dan ham o'zgartirsa bo'ladi.

# ---------- MAJBURIY ----------
# @BotFather bergan token
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Adminlarning Telegram ID lari, vergul bilan (@userinfobot orqali bilib olasiz)
ADMIN_IDS=123456789,987654321
# Railway'da aynan shunday: ${{Postgres.DATABASE_URL}}  (bo'sh bo'lsa lokal SQLite)
DATABASE_URL=
# Web admin-panel paroli (kamida 12 belgi, harf+raqam)
ADMIN_PANEL_PASSWORD=

# ---------- WEBINAR ----------
# Dars vaqti, Toshkent vaqti bilan
WEBINAR_DATETIME=2026-10-25 20:00
# Dars oxirida aytiladigan kod so'z (katta-kichik harf farqi yo'q)
CODEWORD=AZAPRO

# ---------- KANALLAR (bot hammasida ADMIN bo'lishi kerak) ----------
FREE_CHANNEL_ID=-1001111111111
FREE_CHANNEL_LINK=https://t.me/bepul_kanal
PAID_CHANNEL_ID=-1002222222222
# Premium to'laganlar qo'shiladigan kurs guruhi
COURSE_GROUP_ID=-1003333333333
# Standart to'laganlar uchun dars yozuvlari chati (kanal yoki guruh)
RECORDINGS_CHAT_ID=-1004444444444

# ---------- NARXLAR (so'm) ----------
PRICE_STANDARD_FULL=500000
PRICE_STANDARD_OFFER=350000
PRICE_PREMIUM_FULL=1500000
PRICE_PREMIUM_OFFER=990000
PREMIUM_SEATS=20
OFFER_HOURS=48
PAID_CHANNEL_PRICE=25000

# ---------- TO'LOV KARTASI ----------
CARD_NUMBER=8600 1234 5678 9012
CARD_HOLDER=Azamatjon Nabiyev

# ---------- BOSHQA ----------
TIMEZONE=Asia/Tashkent
# true — barcha taymerlar soat o'rniga DAQIQA (sinash uchun). Haqiqiy ishga tushirishda false!
TEST_MODE=false
# Lokal testda panel http://localhost:8080 da ochiladi. Railway PORT ni o'zi beradi.
PORT=8080
